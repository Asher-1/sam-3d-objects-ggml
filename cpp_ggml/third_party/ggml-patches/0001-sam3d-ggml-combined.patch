diff --git a/src/ggml-cuda/sam3d-fattn.cu b/src/ggml-cuda/sam3d-fattn.cu
new file mode 100644
index 0000000000000000000000000000000000000000..e9a485f10e363c30b02962f80c738b2337c216ed
--- /dev/null
+++ b/src/ggml-cuda/sam3d-fattn.cu
@@ -0,0 +1,192 @@
+#include "common.cuh"
+#include "fattn.cuh"
+
+#include <ATen/native/transformers/cuda/mem_eff_attention/kernel_forward.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace {
+
+using Sam3dAttentionKernel = PyTorchMemEffAttention::AttentionKernel<
+    cutlass::half_t, cutlass::arch::Sm80, true, 64, 64, 64, true, true>;
+
+// This is the body of PyTorch 2.5.1's
+// fmha_cutlassF_f16_aligned_64x64_rf_sm80 kernel. Keeping the same
+// instantiation and launch shape preserves its tensor-core reduction order.
+__global__ void __launch_bounds__(
+    Sam3dAttentionKernel::kNumThreads, Sam3dAttentionKernel::kMinBlocksPerSm)
+sam3d_pytorch_fmha_cutlass_f16_aligned_64x64_rf_sm80(
+        Sam3dAttentionKernel::Params params) {
+#if defined(__CUDA_ARCH__)
+#if __CUDA_ARCH__ >= 800 && __CUDA_ARCH__ < 1000
+    if (!params.advance_to_block()) {
+        return;
+    }
+    Sam3dAttentionKernel::attention_kernel(params);
+#else
+    printf("SAM3D F16 masked attention requires sm80-sm90, built for sm%d\\n",
+           static_cast<int>(__CUDA_ARCH__) / 10);
+#endif
+#endif
+}
+
+__global__ void sam3d_assign_window_groups(
+        const int32_t* sequence_lengths, int32_t window_count,
+        int32_t* groups, int32_t token_count) {
+    if (blockIdx.x != 0 || threadIdx.x != 0) {
+        return;
+    }
+
+    int32_t offset = 0;
+    for (int32_t window = 0; window < window_count; ++window) {
+        const int32_t length = sequence_lengths[window];
+        if (length <= 0 || offset > token_count - length) {
+            for (int32_t token = offset; token < token_count; ++token) {
+                groups[token] = -1;
+            }
+            return;
+        }
+        for (int32_t token = 0; token < length; ++token) {
+            groups[offset + token] = window;
+        }
+        offset += length;
+    }
+    for (int32_t token = offset; token < token_count; ++token) {
+        groups[token] = -1;
+    }
+}
+
+__global__ void sam3d_build_dense_bias(
+        const int32_t* groups, int32_t token_count, int32_t padded_key_count,
+        cutlass::half_t* bias) {
+    const int64_t index = static_cast<int64_t>(blockIdx.x) * blockDim.x + threadIdx.x;
+    const int64_t elements = static_cast<int64_t>(token_count) * padded_key_count;
+    if (index >= elements) {
+        return;
+    }
+    const int32_t query = static_cast<int32_t>(index / padded_key_count);
+    const int32_t key = static_cast<int32_t>(index % padded_key_count);
+    const bool is_valid = key < token_count && groups[query] >= 0 && groups[query] == groups[key];
+    // IEEE 754 binary16 negative infinity. PyTorch materializes the same value
+    // in the block-diagonal additive attention mask before expanding its heads.
+    bias[index] = is_valid ? cutlass::half_t(0.0f) : cutlass::half_t::bitcast(0xfc00);
+}
+
+constexpr size_t kSam3dAlignment = 128;
+
+size_t sam3d_align_up(size_t size) {
+    return (size + kSam3dAlignment - 1) & ~(kSam3dAlignment - 1);
+}
+
+bool sam3d_layout_supported(int device, const ggml_tensor* dst) {
+    const ggml_tensor* q = dst->src[0];
+    const ggml_tensor* k = dst->src[1];
+    const ggml_tensor* v = dst->src[2];
+    const ggml_tensor* sequence_lengths = dst->src[3];
+    if (ggml_cuda_info().devices[device].cc < GGML_CUDA_CC_AMPERE ||
+        ggml_cuda_info().devices[device].cc >= 1000 || q == nullptr || k == nullptr ||
+        v == nullptr || sequence_lengths == nullptr) {
+        return false;
+    }
+    if (q->type != GGML_TYPE_F16 || k->type != GGML_TYPE_F16 || v->type != GGML_TYPE_F16 ||
+        dst->type != GGML_TYPE_F16 || sequence_lengths->type != GGML_TYPE_I32 ||
+        !ggml_is_contiguous(q) || !ggml_is_contiguous(k) || !ggml_is_contiguous(v) ||
+        !ggml_is_contiguous(sequence_lengths)) {
+        return false;
+    }
+    return q->ne[0] == 64 && q->ne[1] > 0 && q->ne[2] > 0 && q->ne[3] == 1 &&
+           q->ne[0] == k->ne[0] && q->ne[1] == k->ne[1] && q->ne[2] == k->ne[2] &&
+           q->ne[0] == v->ne[0] && q->ne[1] == v->ne[1] && q->ne[2] == v->ne[2] &&
+           dst->ne[0] == q->ne[0] && dst->ne[1] == q->ne[1] &&
+           dst->ne[2] == q->ne[2] && dst->ne[3] == q->ne[3] &&
+           sequence_lengths->ne[0] > 0 && sequence_lengths->ne[0] <= INT32_MAX;
+}
+
+}  // namespace
+
+bool ggml_cuda_sam3d_f16_masked_attn_supported(int device, const ggml_tensor* dst) {
+    return dst != nullptr && dst->op == GGML_OP_SAM3D_F16_MASKED_ATTN &&
+           sam3d_layout_supported(device, dst);
+}
+
+size_t ggml_cuda_sam3d_f16_masked_attn_get_alloc_size(int device, const ggml_tensor* dst) {
+    GGML_ASSERT(ggml_cuda_sam3d_f16_masked_attn_supported(device, dst));
+    const int64_t token_count = dst->ne[2];
+    const int64_t padded_key_count = (token_count + 7) & ~int64_t(7);
+    GGML_ASSERT(token_count <= INT32_MAX && padded_key_count <= INT32_MAX &&
+                static_cast<uint64_t>(token_count) * padded_key_count <=
+                    std::numeric_limits<size_t>::max() / sizeof(cutlass::half_t));
+
+    size_t size = sam3d_align_up(ggml_nbytes(dst));
+    size += sam3d_align_up(static_cast<size_t>(token_count) * sizeof(int32_t));
+    size += static_cast<size_t>(token_count) * padded_key_count * sizeof(cutlass::half_t);
+    return size;
+}
+
+void ggml_cuda_sam3d_f16_masked_attn(ggml_backend_cuda_context& ctx, ggml_tensor* dst) {
+    GGML_ASSERT(ggml_cuda_sam3d_f16_masked_attn_supported(ctx.device, dst));
+    const ggml_tensor* q = dst->src[0];
+    const ggml_tensor* k = dst->src[1];
+    const ggml_tensor* v = dst->src[2];
+    const ggml_tensor* sequence_lengths = dst->src[3];
+    const int32_t token_count = static_cast<int32_t>(q->ne[2]);
+    const int32_t head_count = static_cast<int32_t>(q->ne[1]);
+    const int32_t padded_key_count = (token_count + 7) & ~int32_t(7);
+    const int32_t window_count = static_cast<int32_t>(sequence_lengths->ne[0]);
+
+    char* scratch = static_cast<char*>(dst->data) + sam3d_align_up(ggml_nbytes(dst));
+    int32_t* groups = reinterpret_cast<int32_t*>(scratch);
+    scratch += sam3d_align_up(static_cast<size_t>(token_count) * sizeof(int32_t));
+    cutlass::half_t* bias = reinterpret_cast<cutlass::half_t*>(scratch);
+
+    sam3d_assign_window_groups<<<1, 1, 0, ctx.stream()>>>(
+        static_cast<const int32_t*>(sequence_lengths->data), window_count, groups, token_count);
+    constexpr int kBiasThreads = 256;
+    const int64_t bias_elements = static_cast<int64_t>(token_count) * padded_key_count;
+    const int64_t bias_blocks = (bias_elements + kBiasThreads - 1) / kBiasThreads;
+    GGML_ASSERT(bias_blocks <= INT32_MAX);
+    sam3d_build_dense_bias<<<static_cast<unsigned int>(bias_blocks), kBiasThreads, 0, ctx.stream()>>>(
+        groups, token_count, padded_key_count, bias);
+
+    Sam3dAttentionKernel::Params params;
+    params.query_ptr = static_cast<const cutlass::half_t*>(q->data);
+    params.key_ptr = static_cast<const cutlass::half_t*>(k->data);
+    params.value_ptr = static_cast<const cutlass::half_t*>(v->data);
+    params.attn_bias_ptr = bias;
+    params.output_ptr = static_cast<cutlass::half_t*>(dst->data);
+    params.scale = ggml_get_op_params_f32(dst, 0);
+    params.head_dim = static_cast<int32_t>(q->ne[0]);
+    params.head_dim_value = static_cast<int32_t>(v->ne[0]);
+    params.num_queries = token_count;
+    params.num_keys = token_count;
+    params.q_strideM = static_cast<int32_t>(q->nb[2] / sizeof(cutlass::half_t));
+    params.k_strideM = static_cast<int32_t>(k->nb[2] / sizeof(cutlass::half_t));
+    params.v_strideM = static_cast<int32_t>(v->nb[2] / sizeof(cutlass::half_t));
+    params.o_strideM = static_cast<int32_t>(dst->nb[2] / sizeof(cutlass::half_t));
+    params.bias_strideM = padded_key_count;
+    params.q_strideH = static_cast<int32_t>(q->nb[1] / sizeof(cutlass::half_t));
+    params.k_strideH = static_cast<int32_t>(k->nb[1] / sizeof(cutlass::half_t));
+    params.v_strideH = static_cast<int32_t>(v->nb[1] / sizeof(cutlass::half_t));
+    params.bias_strideH = 0;
+    params.q_strideB = q->nb[3] / sizeof(cutlass::half_t);
+    params.k_strideB = k->nb[3] / sizeof(cutlass::half_t);
+    params.v_strideB = v->nb[3] / sizeof(cutlass::half_t);
+    params.bias_strideB = 0;
+    params.num_batches = 1;
+    params.num_heads = head_count;
+    GGML_ASSERT(Sam3dAttentionKernel::check_supported(params));
+
+    const size_t shared_bytes = sizeof(Sam3dAttentionKernel::SharedStorage);
+    const size_t maximum_shared_bytes = ggml_cuda_info().devices[ctx.device].smpbo;
+    GGML_ASSERT(shared_bytes <= maximum_shared_bytes);
+    if (shared_bytes > ggml_cuda_info().devices[ctx.device].smpb) {
+        CUDA_CHECK(cudaFuncSetAttribute(
+            sam3d_pytorch_fmha_cutlass_f16_aligned_64x64_rf_sm80,
+            cudaFuncAttributeMaxDynamicSharedMemorySize, static_cast<int>(shared_bytes)));
+    }
+    sam3d_pytorch_fmha_cutlass_f16_aligned_64x64_rf_sm80<<<
+        params.getBlocksGrid(), params.getThreadsGrid(), shared_bytes, ctx.stream()>>>(params);
+    CUDA_CHECK(cudaGetLastError());
+}
