+        input->ne[2] != 1 || input->ne[3] != 1 ||
+        mul_mat->ne[2] != 1 || mul_mat->ne[3] != 1 ||
+        dst->ne[2] != 1 || dst->ne[3] != 1 ||
+        bias->ne[0] != mul_mat->ne[0] || ggml_nrows(bias) != 1 ||
+        !ggml_are_same_shape(mul_mat, dst) ||
