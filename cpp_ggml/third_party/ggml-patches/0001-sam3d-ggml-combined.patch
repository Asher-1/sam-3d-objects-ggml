+        weights->type != GGML_TYPE_F16 || input->type != GGML_TYPE_F16 ||
+        bias->type != GGML_TYPE_F16 || mul_mat->type != GGML_TYPE_F32 ||
+        dst->type != GGML_TYPE_F16 || mul_mat->op_params[0] != GGML_PREC_F32 ||
+        !ggml_is_contiguous(weights) || !ggml_is_contiguous(input) ||
+        !ggml_is_contiguous(bias) || !ggml_is_contiguous(dst) ||
