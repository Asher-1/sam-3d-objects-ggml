+static bool ggml_cuda_mul_mat_f16_bias_cublaslt(ggml_backend_cuda_context & ctx,
+                                                 const ggml_tensor * mul_mat,
+                                                 const ggml_tensor * bias,
+                                                 ggml_tensor * dst) {
+    const ggml_tensor * weights = mul_mat->src[0];
+    const ggml_tensor * input   = mul_mat->src[1];
