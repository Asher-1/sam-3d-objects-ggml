+    const int64_t count = rows * cols;
+    const int blocks = static_cast<int>((count + threads - 1) / threads);
+    ggml_cuda_transpose_f16_linear_weights<<<blocks, threads, 0, ctx.stream()>>>(
+        static_cast<const uint16_t *>(weights->data), static_cast<uint16_t *>(entry.data), rows, cols);
+    CUDA_CHECK(cudaGetLastError());
+    const auto [it, inserted] = cache.emplace(weights, entry);
